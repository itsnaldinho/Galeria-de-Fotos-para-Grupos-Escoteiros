<!DOCTYPE html>
<html lang="pt-BR">
<head>
<base target="_top">
<style>
*{box-sizing:border-box;margin:0}
body{font-family:Montserrat,system-ui,Arial,sans-serif;background:#eef2f4;color:#12303f;padding:24px}
.wrap{max-width:1000px;margin:auto}
h1{margin-bottom:16px}
.box{background:#fff;border-radius:14px;padding:20px;box-shadow:0 2px 10px #0001;margin-bottom:20px}
label{display:block;font-size:12px;font-weight:700;margin:12px 0 4px;color:#4a6a7a}
input,select{width:100%;padding:10px;border:1px solid #cdd8de;border-radius:8px;font:inherit}
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
button{padding:10px 16px;border:0;border-radius:8px;background:#0b2b3b;color:#fff;font-weight:700;cursor:pointer;font:inherit;font-weight:700}
button.gold{background:#f0c24b;color:#12303f}button.red{background:#c0392b}button.gray{background:#8aa0ac}
.item{display:flex;gap:14px;align-items:center;padding:10px 0;border-bottom:1px solid #e3eaee}
.item img{width:80px;height:56px;object-fit:cover;border-radius:8px;background:#dfe7eb}
.item .t{flex:1}.item small{color:#5f7c8a;display:block}
.item button{padding:7px 11px;font-size:12px}
#msg{margin-top:12px;font-weight:700}
.hint{font-size:12px;color:#5f7c8a;margin-top:4px}
@media(max-width:700px){.row{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
  <h1>⚜ Admin da Galeria</h1>

  <div class="box" id="login">
    <label>Senha</label><input type="password" id="pwd" onkeydown="if(event.key==='Enter')entrar()">
    <p style="margin-top:12px"><button onclick="entrar()">Entrar</button></p><div id="msgL" style="color:#c0392b;margin-top:8px"></div>
  </div>

  <div id="painel" style="display:none">
    <div class="box">
      <h3 id="formTit">Novo álbum</h3>
      <input type="hidden" id="id">
      <label>Título do álbum</label><input id="titulo" placeholder="Ex.: Dia 1 - ARRE e DSR">
      <div class="row">
        <div><label>Localização</label><input id="local" placeholder="Ex.: Divinópolis/MG"></div>
        <div><label>Data do evento</label><input type="date" id="data"></div>
      </div>
      <div class="row">
        <div><label>Ano (opcional, automático pela data)</label><input id="ano" placeholder="2026"></div>
        <div><label>Visível ao público?</label><select id="visivel"><option value="true">Sim</option><option value="false">Não (oculto)</option></select></div>
      </div>
      <label>Link da pasta do Google Drive (compartilhada: "qualquer pessoa com o link")</label>
      <input id="pasta" placeholder="https://drive.google.com/drive/folders/...">
      <label>Foto de capa — link de uma foto do Drive (opcional)</label>
      <input id="capa" placeholder="Em branco = usa a primeira foto da pasta">
      <p class="hint">Dica: no Drive, clique com o botão direito na foto → Compartilhar → Copiar link.</p>
      <p style="margin-top:16px;display:flex;gap:8px">
        <button class="gold" onclick="salvar()">Salvar álbum</button>
        <button class="gray" onclick="limpar()">Limpar</button>
      </p>
      <div id="msg"></div>
    </div>

    <div class="box">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <h3>Álbuns cadastrados</h3>
        <button class="gray" onclick="atualizar('')">Recontar fotos de todos</button>
      </div>
      <div id="lista"></div>
    </div>
    <p><a href="<?!= baseUrl ?>" target="_blank">Abrir galeria pública →</a></p>
  </div>
</div>

<script>
const BASE = "<?!= baseUrl ?>";
const $ = s => document.querySelector(s);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const run = (fn, ...a) => new Promise((ok, err) => google.script.run.withSuccessHandler(ok).withFailureHandler(e => err(e))[fn](...a));
let pwd = '', lista = [];

async function entrar() {
  pwd = $('#pwd').value;
  try { await run('adminLogin', pwd); $('#login').style.display = 'none'; $('#painel').style.display = 'block'; carregar(); }
  catch (e) { $('#msgL').textContent = e.message.replace('Error: ', ''); }
}


async function carregar() {
  try {
    lista = await run('adminListar', pwd);
  } catch (e) {
    $('#lista').innerHTML = '<p style="color:#c0392b">Erro ao carregar: ' + esc(e.message) + '</p>';
    return;
  }
  lista.sort((a, b) => String(b.data).localeCompare(String(a.data)));
  $('#lista').innerHTML = lista.map(a => `
    <div class="item">
      <img src="https://drive.google.com/thumbnail?id=${a.capaId}&sz=w200">
      <div class="t"><b>${esc(a.titulo)}</b><small>${a.ano} · ${esc(a.local)} · ${a.fotos} fotos ${a.visivel ? '' : '· 🚫 oculto'}</small></div>
      <button class="gray" onclick="copiar('${a.id}')">Link</button>
      <button class="gray" onclick="atualizar('${a.id}')">Recontar</button>
      <button onclick="editar('${a.id}')">Editar</button>
      <button class="red" onclick="excluir('${a.id}')">Excluir</button>
    </div>`).join('') || '<p>Nenhum álbum ainda.</p>';
}


function editar(id) {
  const a = lista.find(x => x.id === id);
  $('#formTit').textContent = 'Editando: ' + a.titulo;
  $('#id').value = a.id; $('#titulo').value = a.titulo; $('#local').value = a.local;
  $('#data').value = a.data; $('#ano').value = a.ano; $('#visivel').value = String(a.visivel);
  $('#pasta').value = 'https://drive.google.com/drive/folders/' + a.pastaId;
  $('#capa').value = a.capaId ? 'https://drive.google.com/file/d/' + a.capaId : '';
  scrollTo(0, 0);
}
function limpar() {
  ['id','titulo','local','data','ano','pasta','capa'].forEach(k => $('#' + k).value = '');
  $('#visivel').value = 'true'; $('#formTit').textContent = 'Novo álbum'; $('#msg').textContent = '';
}
async function salvar() {
  const m = $('#msg'); m.style.color = '#12303f'; m.textContent = 'Salvando e lendo as fotos do Drive...';
  try {
    const r = await run('adminSalvar', pwd, {
      id: $('#id').value, titulo: $('#titulo').value.trim(), local: $('#local').value.trim(),
      data: $('#data').value, ano: $('#ano').value.trim(), pasta: $('#pasta').value,
      capa: $('#capa').value, visivel: $('#visivel').value === 'true'
    });
    m.textContent = '✔ Salvo! ' + r.fotos + ' fotos encontradas.'; limpar(); m.textContent = '✔ Salvo! ' + r.fotos + ' fotos encontradas.'; carregar();
  } catch (e) { m.style.color = '#c0392b'; m.textContent = '✖ ' + e.message.replace('Error: ', ''); }
}
async function excluir(id) {
  if (!confirm('Excluir este álbum? (as fotos no Drive não são apagadas)')) return;
  await run('adminExcluir', pwd, id); carregar();
}
async function atualizar(id) { $('#msg').textContent = 'Atualizando...'; await run('adminAtualizar', pwd, id); $('#msg').textContent = '✔ Atualizado'; carregar(); }
function copiar(id) { prompt('Link direto do álbum:', BASE + '?album=' + id); }
</script>
</body>
</html>
